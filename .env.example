# --- Required ---
# NEVER put a real token in this file — it is a committed template. Copy to `.env`.
NAUTOBOT_URL=https://demo.nautobot.com
NAUTOBOT_TOKEN=replace_with_a_read_only_api_token

# --- Optional (NAUTOBOT_MCP_ prefix) ---
# Transport: stdio | streamable-http | sse
#   stdio           = local use + VS Code/Claude/MCP clients (recommended locally).
#   streamable-http = for Copilot Studio / remote. Needs uvicorn, which imports
#                     _multiprocessing — locked-down Windows (Smart App Control / WDAC)
#                     may BLOCK that. If so, run HTTP in Docker (see README), not on the host.
NAUTOBOT_MCP_TRANSPORT=stdio

# HTTP transport (only when TRANSPORT=streamable-http). No auth yet (OAuth planned) —
# keep on localhost or behind a private gateway/tunnel.
NAUTOBOT_MCP_HOST=127.0.0.1
NAUTOBOT_MCP_PORT=8000
NAUTOBOT_MCP_STREAMABLE_HTTP_PATH=/mcp

# Behaviour
NAUTOBOT_MCP_MAX_ITEMS=200                 # cap on list responses (row count)
NAUTOBOT_MCP_MAX_RESPONSE_CHARS=60000      # per-tool response size budget (~15k tokens)
NAUTOBOT_MCP_RESOLVER_CACHE_TTL=120        # seconds to cache reference lists (locations/roles/statuses)
NAUTOBOT_MCP_REQUEST_TIMEOUT_SECONDS=20
NAUTOBOT_MCP_TOOL_TIMEOUT_SECONDS=45
NAUTOBOT_MCP_MAX_CONCURRENT_REQUESTS=8
NAUTOBOT_MCP_MAX_RETRIES=2                  # auto-retry GET on timeout / 502-504 / transport error
NAUTOBOT_MCP_VERIFY_TLS=true
NAUTOBOT_MCP_LOG_LEVEL=INFO

# Feature flags — keep the default surface lean
NAUTOBOT_MCP_ENABLE_OPTIONAL_TOOLS=false   # jobs, circuits, racks
